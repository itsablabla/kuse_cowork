{
  "name": "kuse-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Kuse AI (app.kuse.ai) — exposes all API endpoints as MCP tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kuse-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && cp src/openapi.json dist/openapi.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
